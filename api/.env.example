# Copy to api/.env on the server. api/.env is ignored by git and denied by .htaccess.
# Local development: leave DB_DSN empty and SQLite is used at var/sdo.sqlite.

# Hostinger MySQL (hPanel → Databases)
DB_DSN=mysql:host=localhost;dbname=u000000_sdo;charset=utf8mb4
DB_USER=u000000_sdo
DB_PASS=change-me

# Random 32+ characters. Signs session cookies.
APP_SECRET=change-me-to-a-long-random-string

# Stripe (session 2). Test keys locally, live keys only on the production server.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Where the site lives (used for Stripe return URLs and email links)
SITE_URL=https://sundestinonline.com

# Cron endpoint key (hPanel → Cron Jobs calls api/cron/expire_holds.php?key=...)
CRON_KEY=change-me

# Booking emails (a Hostinger mailbox on the same domain)
MAIL_FROM=stay@sundestinonline.com
OWNER_EMAIL=owner@example.com
